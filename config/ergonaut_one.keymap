#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NUM  1
#define FUN  2

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // Both shifts = caps word
        combo_capsword {
            timeout-ms = <50>;
            key-positions = <37 40>;
            bindings = <&caps_word>;
            layers = <BASE>;
        };

        // Both inner thumbs = toggle NUM layer (works on BASE and NUM so it can toggle off)
        combo_num_lock {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&tog NUM>;
            layers = <BASE NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // The outer top and middle keys are unused so the layout matches the Totem.
        // The outer bottom keys are the Totem's extra pinky keys.

        base_layer {
            display-name = "BASE";
            bindings = <
&mt LEFT_GUI ESCAPE  &kp Q  &kp W  &kp E      &kp R                     &kp T         &kp Y        &kp U            &kp I         &kp O    &kp P          &kp MINUS
&kp LEFT_ALT         &kp A  &kp S  &kp D      &kp F                     &kp G         &kp H        &kp J            &kp K         &kp L    &kp SEMICOLON  &mt RALT SQT
&kp LCTRL            &kp Z  &kp X  &kp C      &kp V                     &kp B         &kp N        &kp M            &kp COMMA     &kp DOT  &kp FSLH       &mt RCTRL CAPSLOCK
                                   &lt 2 TAB  &mt LEFT_SHIFT BACKSPACE  &lt 1 DELETE  &lt 1 ENTER  &mt RSHFT SPACE  &lt 2 ESCAPE
            >;
        };

num_layer {
    display-name = "NUM";
    bindings = <
&trans  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS       &kp STAR        &kp LPAR            &kp RPAR       &kp PLUS
&trans  &kp N1     &kp N2    &kp N3    &kp N4    &kp N5     &kp N6     &kp N7         &kp N8          &kp N9              &kp N0         &mt RALT MINUS
&trans  &kp GRAVE  &kp BSLH  &kp INS   &kp LBKT  &kp RBKT   &kp DOT    &mt HOME LEFT  &mt PAGE_UP UP  &mt PAGE_DOWN DOWN  &mt END RIGHT  &mt RCTRL EQUAL
                             &trans    &trans    &trans     &trans     &trans         &trans
    >;
};

        func_layer {
            display-name = "FUN";
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &kp F4  &kp F5  &kp F6  &kp F11  &none
&sys_reset   &none         &none         &none         &none         &none         &none   &kp F1  &kp F2  &kp F3  &kp F12  &none
                                         &trans        &trans        &trans        &trans  &trans  &trans
            >;
        };
    };
};
