#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    behaviors {
        ts: thumb_space {
            compatible = "zmk,behavior-hold-tap";
            label = "THUMB_SPACE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred"; // Tells ZMK: "If I hit another key quickly, I meant SPACE, not SHIFT"
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&mt LEFT_GUI ESCAPE  &kp Q  &kp W  &kp E               &kp R            &kp T         &kp Y        &kp U            &kp I         &kp O    &kp P          &kp MINUS
&kp TAB              &kp A  &kp S  &kp D               &kp F            &kp G         &kp H        &kp J            &kp K         &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL            &kp Z  &kp X  &kp C               &kp V            &kp B         &kp N        &kp M            &kp COMMA     &kp DOT  &kp FSLH       &kp RIGHT_ALT
                                   &mt LEFT_SHIFT TAB  &lt 2 BACKSPACE  &lt 1 DELETE  &lt 1 ENTER  &ts RSHFT SPACE  &lt 2 ESCAPE
            >;
        };

        Nav {
            display-name = "Navigation";
            bindings = <
&trans  &trans      &kp CAPS  &trans      &kp K_REDO  &trans  &kp C_VOL_UP  &kp HOME  &kp UP_ARROW     &kp PG_UP  &kp PRINTSCREEN  &trans
&trans  &trans      &trans    &trans      &trans      &trans  &kp C_MUTE    &kp LEFT  &kp PRINTSCREEN  &kp RIGHT  &kp INS          &trans
&trans  &kp K_UNDO  &trans    &caps_word  &trans      &trans  &kp C_VOL_DN  &kp END   &kp DOWN         &kp PG_DN  &kp PAUSE_BREAK  &trans
                              &trans      &trans      &trans  &trans        &trans    &trans
            >;
        };

        Num {
            bindings = <
&trans  &kp EXCL     &kp AT_SIGN  &kp HASH       &kp DOLLAR    &kp BACKSLASH         &kp SLASH              &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp N0     &trans
&trans  &kp PERCENT  &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &trans
&trans  &kp GRAVE    &trans       &trans         &kp PERIOD    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &trans
                                  &trans         &trans        &trans                &trans                 &trans        &trans
            >;
        };

        Fn {
            display-name = "ADJ";
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &kp F4  &kp F5  &kp F6  &kp F11  &none
&sys_reset   &none         &none         &none         &none         &none         &none   &kp F1  &kp F2  &kp F3  &kp F12  &none
                                         &trans        &trans        &trans        &trans  &trans  &trans
            >;
        };
    };
};
