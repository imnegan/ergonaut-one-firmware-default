#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 17 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 18 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri-layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&mt LEFT_GUI ESCAPE  &kp Q         &kp W            &kp E               &kp R              &kp T         &kp Y        &kp U               &kp I             &kp O             &kp P                         &kp LEFT_BRACKET
&kp TAB              &hml LCTRL A  &hml LEFT_GUI S  &hml LEFT_ALT D     &hml LEFT_SHIFT F  &kp G         &kp H        &hmr RIGHT_SHIFT J  &hmr RIGHT_ALT K  &hmr RIGHT_GUI L  &hmr RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LCTRL            &kp Z         &kp X            &kp C               &kp V              &kp B         &kp N        &kp M               &kp COMMA         &kp DOT           &kp FSLH                      &kp RIGHT_ALT
                                                    &mt LEFT_SHIFT TAB  &lt 2 BACKSPACE    &lt 1 DELETE  &lt 1 ENTER  &mt RSHFT SPACE     &lt 2 ESCAPE
            >;
        };

        Nav {
            display-name = "Navigation";
            bindings = <
&trans  &kp KP_SLASH  &caps_word  &trans      &kp K_REDO  &trans  &kp C_VOL_UP  &kp HOME  &kp UP_ARROW     &kp PG_UP  &kp PRINTSCREEN  &trans
&trans  &trans        &trans      &trans      &trans      &trans  &kp C_MUTE    &kp LEFT  &kp PRINTSCREEN  &kp RIGHT  &kp INS          &trans
&trans  &kp K_UNDO    &trans      &caps_word  &trans      &trans  &kp C_VOL_DN  &kp END   &kp DOWN         &kp PG_DN  &kp PAUSE_BREAK  &trans
                                  &trans      &trans      &trans  &trans        &trans    &trans
            >;
        };

        Num {
            bindings = <
&trans  &kp EXCL     &kp AT_SIGN  &kp HASH       &kp DOLLAR    &kp BACKSLASH         &kp SLASH              &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp MINUS  &trans
&trans  &kp PERCENT  &kp CARET    &kp AMPERSAND  &kp ASTERISK  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &trans
&trans  &kp GRAVE    &trans       &trans         &kp PERIOD    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &trans
                                  &trans         &trans        &trans                &trans                 &trans        &kp N0
            >;
        };

        Fn {
            display-name = "ADJ";
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none   &kp F4  &kp F5  &kp F6  &kp F12  &none
&sys_reset   &none         &none         &none         &none         &none         &none   &kp F1  &kp F2  &kp F3  &none    &none
                                         &trans        &trans        &trans        &trans  &trans  &trans
            >;
        };
    };
};
